APP_NAME=ReviewPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development works out of the box with SQLite.
# Production: PostgreSQL 16+ (EU region).
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=reviewpilot
# DB_USERNAME=reviewpilot
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# ReviewPilot
# ---------------------------------------------------------------------------
# Production checklist (verify with `php artisan reviewpilot:doctor`):
#   APP_ENV=production, APP_DEBUG=false, APP_URL=https://..., SESSION_SECURE_COOKIE=true,
#   SESSION_ENCRYPT=true, LOG_STACK=daily (or stderr on Laravel Cloud), DB_CONNECTION=pgsql,
#   a real MAIL_MAILER (email verification, alerts and invitations depend on it).
#   Never change APP_KEY after go-live without APP_PREVIOUS_KEYS: Google tokens are encrypted with it.
# Emergency stop for all automatic publishing: REVIEWPILOT_AUTOMATION_DISABLED=true
#   (or: php artisan reviewpilot:automation pause)
# Production: QUEUE_CONNECTION=redis and CACHE_STORE=redis, with a queue worker for
#   php artisan queue:work --queue=realtime,ai,sync,notifications,backfill,default
# and the scheduler (php artisan schedule:run every minute).

# --- Claude (Anthropic) ------------------------------------------------------
# "fake" = offline demo AI (no key needed). Set to "anthropic" to use Claude.
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
# Optional overrides (defaults: claude-opus-5-5, effort low for analysis / medium for drafts)
# AI_MODEL_ANALYSIS=claude-opus-5-5
# AI_MODEL_DRAFT=claude-opus-5-5
# AI_EFFORT_ANALYSIS=low
# AI_EFFORT_DRAFT=medium

# --- Google Business Profile ------------------------------------------------
# OAuth client (Google Cloud Console > APIs & Services > Credentials, type "Web application").
# Authorised redirect URI: ${APP_URL}/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Optional: real-time review notifications via Cloud Pub/Sub (polling is used otherwise)
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# GBP_REQUESTS_PER_MINUTE=240
# REVIEWPILOT_POLL_MINUTES=15

# --- Mollie (billing) ---------------------------------------------------------
# test_... key from the Mollie dashboard; live_... in production.
MOLLIE_KEY=
REVIEWPILOT_VAT_RATE=0.21
REVIEWPILOT_TRIAL_DAYS=14

# Seed the demo organisation outside local/testing (demo@reviewpilot.test / password)
# SEED_DEMO=true

